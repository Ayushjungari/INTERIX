# Backend environment
PORT=8000
DB_URL=mongodb+srv://<user>:<password>@<cluster>/<db>
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Clerk (server SDK)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Stream (Chat + Video)
STREAM_API_KEY=xxx
STREAM_API_SECRET=xxx

# Inngest (Clerk -> user sync). In local dev the app also auto-provisions
# users from Clerk when they hit the API, so Inngest is optional for testing.
INNGEST_EVENT_KEY=xxx
INNGEST_SIGNING_KEY=xxx
